{
  "name": "openpulse",
  "version": "5.0.0",
  "private": true,
  "description": "Offline, local-first biometric companion for a user-owned WHOOP 5.0 strap: BLE protocol engine, SQLite store, local physiology scoring and a dark-mode dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && npm run build:daemon",
    "build:daemon": "node scripts/build-daemon.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3000",
    "daemon": "tsx src/lib/daemon/main.ts",
    "daemon:simulate": "tsx src/lib/daemon/main.ts --simulate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/storage/cli.ts migrate",
    "replay": "tsx src/lib/storage/cli.ts replay",
    "recompute": "tsx src/lib/storage/cli.ts recompute",
    "import": "tsx src/lib/importers/cli.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "framer-motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "^6.0.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@abandonware/noble": "^1.9.2-26"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}

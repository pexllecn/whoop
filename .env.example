# Copy to .env.local (never committed). All optional.

# SQLite database location (default: ./data/openpulse.db)
OPENPULSE_DB=./data/openpulse.db

# User protocol map with commands discovered from your own captures
OPENPULSE_PROTOCOL_MAP=./data/protocol-map.json

# Start the daemon with the built-in simulator instead of noble
OPENPULSE_SIMULATE=0

# Cloud coach providers (only used after you allow external providers in Settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
